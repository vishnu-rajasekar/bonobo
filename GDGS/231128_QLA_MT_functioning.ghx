            <chunk name="Object" index="727">
              <items count="3">
                <item name="GUID" type_name="gh_guid" type_code="9">410755b1-224a-4c1e-a407-bf32fb45ea7e</item>
                <item name="Lib" type_name="gh_guid" type_code="9">00000000-0000-0000-0000-000000000000</item>
                <item name="Name" type_name="gh_string" type_code="10">Python Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="14">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import rhinoscriptsyntax as rs
import ghpythonlib.components as gh
import Rhino.Geometry as rg
import Rhino as rc
import System.Drawing as sd

import Assembly as assembly
import Grammar as gr
import Rules as r
import GraphicStatics as gs

reload (assembly)
reload (gs)

################################################################################

tail = rg.Vector3d(Tail)
head = rg.Vector3d(Head)
AppliedForce = rg.Line(Tail, Head)


################################################################################

if Type == "1": #Support Point
    ThisNodeType = assembly.NodeType.Support
    ThisForceType = assembly.ForceType.Reaction
    Color = "252, 223,33" #yellow, for support reactions

if Type == "2": #Load Point
    ThisNodeType = assembly.NodeType.Load
    ThisForceType = assembly.ForceType.Applied
    Color = "0, 113, 189" #blue, for applied loads

################################################################################
# CONSTRUCT ASSEMBLY.FORCE

ForceList=[]
Force = assembly.Force(AppliedForce, ThisForceType, -1)
ForceList.append(Force)


Node = assembly.Node(Head, ThisNodeType, ForceList)

Node = gs.RearrangeForces(Node)
'''Node = gs.EquilibrateNode(Node)
print Node.Forces
################################################################################'''</item>
