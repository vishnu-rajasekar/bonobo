import rhinoscriptsyntax as rs
import ghpythonlib.components as gh
import Rhino.Geometry as rg
import System.Drawing as sd
import math
import random
import copy

################################################################################
#  IMPORT JUNEY FILES
################################################################################
import Assembly as assembly
import Grammar as gr
import Rhino as rc
import Rules as rules
import GraphicStatics as gs

import RandomUtility as ru

import QLA_231127 as qa

reload (assembly)
reload (gs)
reload (rules)
reload (gr)


reload (qa)

################################################################################
#  IMPORT RHINOREMOTE
################################################################################

import scriptcontext
import ghpythonremote
np = scriptcontext.sticky['numpy']
rpy = scriptcontext.sticky['rpy']


import ghpythonlib.treehelpers as th

################################################################################
#  Code for ML 
################################################################################

scriptcontext.sticky['assembly_list'] = []
scriptcontext.sticky['assembly_length'] = []

env.input_length = target_length

agent.train(episodes)


################################################################################
#  Output
################################################################################
'''rules = []
for rule in state:
    rules.append(rule[0])
 
print len(state)
applicablerules = rules'''

"""q_table_df = pd.DataFrame(agent.q_table)
print (q_table_df)"""

assemblies = scriptcontext.sticky['assembly_list']
length = scriptcontext.sticky['assembly_length']

activenodes = gs.GetActiveNodes(env.assembly)
active_nodes=[]
for node in activenodes:
    #force = gs.GetTempForce(node)[0]
    active_nodes.append(node.Coordinate)

assembly = env.assembly
done = env.is_done()
active_nodes
members = env.assembly.Members
history = env.assembly.History.Rules

Environment = env
Agent = agent
