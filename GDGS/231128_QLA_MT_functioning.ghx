            line = force.Line
            start = gh.EndPoints(line)[0]
            end = gh.EndPoints(line)[1]
            
            vector = gh.Vector2Pt(start, end)
            #vector = gs.LineToVector(force.Line)[0]
            memberforcetype.append(vector)'''</item>
