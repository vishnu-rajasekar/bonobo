                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import rhinoscriptsyntax as rs
import ghpythonlib.components as gh
import Rhino.Geometry as rg
import System.Drawing as sd
import math
import random

import Assembly as assembly
import Grammar as gr
import Rhino as rc
import Rules as rules
import GraphicStatics as gs

reload (assembly)
reload (gs)
reload (rules)
reload (gr)


#boundary points
nodecount = len(Assembly.Nodes)
boundary = Assembly.Boundary
boundarypts = gh.DeconstructBrep(boundary)[2]


################################################################################
x = []
y = []
for pt in boundarypts:
    x.append(pt.X)
    y.append(pt.Y)

x = gh.SortList(x)[0]
y = gh.SortList(y)[0]

xrange = x[-1]-x[0]
xmid = xrange/2
startx = x[0]
starty = startyoffset

xcount = 5
xspacing = xrange/xcount
ycount = int(math.ceil(nodecount/xcount))
yspacing = -10

################################################################################
gridofpts = []

firstrowpts = []
for i in range(0,xcount+1):
    pt = rg.Point3d(xspacing*i, starty, 0)
    firstrowpts.append(pt)
gridofpts.append(firstrowpts)

if ycount &gt; 1:
    for i in range(0,ycount-1):
        translation = gh.Vector2Pt(rg.Point3d(0,0,0), rg.Point3d(0,yspacing,0))[0]
        nextrow = gh.Move(gridofpts[-1], translation)[0]
        gridofpts.append(nextrow)
else:
    pass
gridofpts  = [val for sublist in gridofpts for val in sublist]


del gridofpts[nodecount:]



################################################################################
#Force Polygon
polygons = []
for i in range(0,len(Assembly.Nodes)):
    d = gs.DrawNodeForcePolygon(Assembly.Nodes[i], rg.Point3d(gridofpts[i]))
    polygons.append(d)


ReactionForceLines = []
for forcelist in polygons: # for every node
    for force in forcelist: #for every force at node
        if force.Type == 1: #if the force is a temporary force
            ReactionForceLines.append(force.Line)

AppliedForceLines = []
for forcelist in polygons: # for every node
    for force in forcelist: #for every force at node
        if force.Type == 2: #if the force is a temporary force
            AppliedForceLines.append(force.Line)

TempForceLines = []
for forcelist in polygons: # for every node
    for force in forcelist: #for every force at node
        if force.Type == 3: #if the force is a temporary force
            TempForceLines.append(force.Line)

MemberForceLines = []
for forcelist in polygons: # for every node
    for force in forcelist: #for every force at node
        if force.Type == 4: #if the force is a temporary force
            MemberForceLines.append(force.Line)

CompressionMembers =[]
TensionMembers = []
for forcelist in polygons: # for every node
    for force in forcelist: #for every force at node
        if force.Type == 4: #if the force is a temporary force
            if force.Direction == -1:
                CompressionMembers.append(force.Line)
            else:
                TensionMembers.append(force.Line)



################################################################################



colors = ["219, 107,4", "225, 212,0", "140, 198, 63", "58, 178, 221", "0, 105, 151", "216, 75, 141", "146, 10, 120"]
"""
