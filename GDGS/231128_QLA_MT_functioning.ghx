                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import rhinoscriptsyntax as rs
import ghpythonlib.components as gh
import Rhino.Geometry as rg
import System.Drawing as sd
import math
import random

import Assembly as assembly
import Grammar as gr
import Rhino as rc
import Rules as r
import GraphicStatics as gs

reload (assembly)
reload (gs)
reload (r)


nodes = []
for node in Assembly.Nodes:
    nodes.append(node.Coordinate)


TempForceLines = []
for node in Assembly.Nodes: # for every node
    for i in range(0,len(node.Forces)): #for every force at node
        if node.Forces[i].Type == 3: #if the force is a temporary force
            TempForceLines.append(node.Forces[i].Line)

print TempForceLines</item>
