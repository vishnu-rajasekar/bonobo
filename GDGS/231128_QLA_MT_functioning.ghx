              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">"""Provides a scripting component.
    Inputs:
        x: The x script variable
        y: The y script variable
    Output:
        a: The a output variable"""

__author__ = "vishnu"

import rhinoscriptsyntax as rs

import Grasshopper as gh
from System.Drawing import Color

if Switch:
    #reset colorsettings canvas background,grid, shade and edge
    gh.GUI.Canvas.GH_Skin.canvas_back = Color.White
    gh.GUI.Canvas.GH_Skin.canvas_grid = Color.White
else:
    gh.GUI.Canvas.GH_Skin.canvas_back = Color.FromArgb(255, 212, 208, 200); 
    gh.GUI.Canvas.GH_Skin.canvas_grid = Color.FromArgb(30, 0, 0, 0)
#set colorsettings canvas background,grid, shade and edge</item>
