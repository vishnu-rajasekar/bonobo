                    <item name="CodeInput" type_name="gh_string" type_code="10">import rhinoscriptsyntax as rs
import ghpythonlib.components as gh
import Rhino.Geometry as rg
import System.Drawing as sd
import math
import random
import Rhino as rh


import Assembly as assembly
import Grammar as gr
import Rhino as rc
import Rules as r
import GraphicStatics as gs

reload (assembly)
reload (gs)
reload (r)

members =[]

memberforcelines = []
memberforceamplitude = []
memberforcetype = []
test = []

for member in Assembly.Members:
    members.append(member)
    
    membervector = gs.LineToVector(member)[0]
    
    node = gs.GetMemberNodes(member, Assembly)[0]
    test.append(node.Coordinate)
    for force in node.Forces:
        #print "node index,", GetNodeIndex(node, assembly)
        if force.Type == 4:
            memberforcelines.append(force.Line)
            
            vector = gs.LineToVector(force.Line)[0]
            crossproduct = gh.CrossProduct(membervector, vector)[1]
            
            if crossproduct &lt; 0.001 :
                print crossproduct
                amplitude = gh.VectorLength(vector)
                memberforceamplitude.append(amplitude)

                direction = force.Direction
                memberforcetype.append(direction)
    
    
    
    

thickness = []
for type in memberforcetype:
    if type == -1:
        thickness.append(5)
    else:
        thickness.append(1)
        
'''for node in Assembly.Nodes:
    for force in node.Forces:
