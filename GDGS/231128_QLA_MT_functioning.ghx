                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import scriptcontext
import ghpythonremote
np = scriptcontext.sticky['numpy']
rpy = scriptcontext.sticky['rpy']

# Do some numpy stuff
a = np.arange(20).reshape(4, 5)
print(a)
print(np.linalg.eig(np.arange(9).reshape(3, 3)))

# Fast way of sending data for numpy array creation
remote_range = ghpythonremote.deliver(rpy, range(1000))
array = np.array(remote_range)
# This is much slower
#b = np.array(range(1000))

# Get the array back as a local IronPython list
list = ghpythonremote.obtain(array.tolist())

# Get an error
#np.arange(9).reshape(4,3)


