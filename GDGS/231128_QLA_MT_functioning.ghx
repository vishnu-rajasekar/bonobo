                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">"""Provides a scripting component.
    Inputs:
        x: The x script variable
        y: The y script variable
    Output:
        a: The a output variable"""

__author__ = "vishnu"

import rhinoscriptsyntax as rs
import scriptcontext

scriptcontext.sticky['assembly_list'] = []

#a = scriptcontext.sticky['assembly_list']
list = []

length = x.GetLength()

list.append(x.MyState)
list .append(length)

a = list</item>
