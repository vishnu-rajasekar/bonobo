              <items count="3">
                <item name="GUID" type_name="gh_guid" type_code="9">410755b1-224a-4c1e-a407-bf32fb45ea7e</item>
                <item name="Lib" type_name="gh_guid" type_code="9">00000000-0000-0000-0000-000000000000</item>
                <item name="Name" type_name="gh_string" type_code="10">Python Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import rhinoscriptsyntax as rs
import ghpythonlib.components as gh
import Rhino.Geometry as rg
import System.Drawing as sd
import math
import random

import Assembly as assembly
import Grammar as gr
import Rhino as rc
import Rules as rules
import GraphicStatics as gs

reload (assembly)
reload (gs)
reload (rules)
reload (gr)


#boundary points
nodecount = len(Assembly.Nodes)
boundary = Assembly.Boundary
boundarypts = gh.DeconstructBrep(boundary)[2]

colors = [
"219, 107,4",
"225, 212,0",
"140, 198, 63",
"58, 178, 221",
"0, 105, 151",
"216, 75, 141",
"146, 10, 120"]

"""
0. Orange = "219, 107,4"

1. Yellow = "225, 212,0"
2. Green = "140, 198, 63"
3. Sky = "58, 178, 221"
4. Blue = "0, 105, 151"
5. Magenta = "216, 75, 141"

6. Purple = "146, 10, 120"
"""

################################################################################
x = []
y = []
for pt in boundarypts:
    x.append(pt.X)
    y.append(pt.Y)

x = gh.SortList(x)[0]
y = gh.SortList(y)[0]

pt = rg.Point3d(x[-1]+10, y[-1], 0)
pt1 = rg.Point3d(x[-1]+10, y[-1]-3, 0)

################################################################################

history = []
for t in Assembly.History.Rules:
    b = t[2].Name, 'applied at Node', t[0]
    history.append(b)

print history[-1]
################################################################################

ptlist = []
ptlist.append(pt1)

vector = gh.UnitY(-1.5)
for i in range(0,len(history)-1):
    mpt = gh.Move(ptlist[-1], vector)[0]
    ptlist.append(mpt)

################################################################################

colorlist = []
for i in range(0,len(history)):
    if history[i][0] == "Rule 0: 'START'":
        colorlist.append(colors[0]) #0. Orange = 219, 107,4

    elif history[i][0] == "Rule 1: 'Create Node'":
        colorlist.append(colors[1]) #1. Yellow = 225, 212,0

    elif history[i][0] == "Rule 2: 'Extend Node'":
        colorlist.append(colors[2]) #2. Green = 140, 198, 63

    elif history[i][0] == "Rule 3: 'Split Node'":
        colorlist.append(colors[3]) #3. Sky = 58, 178, 221

    elif history[i][0] == "Rule 4: 'Connect with Element'":
        colorlist.append(colors[4]) #4. Blue = 0, 105, 151

    elif history[i][0] == "Rule 5: 'Connect via Projection'":
        colorlist.append(colors[5]) #5. Magenta = 216, 75, 141

    if history[i][0] == "Rule 7: 'System Close'" or history[i][0] == "Rule 8: 'END'":
        colorlist.append(colors[6]) #6. Purple = 146, 10, 120



################################################################################

indexlist = []
historywithindex = []
for i in range(0,len(history)):
    indexlist.append((i+1,'.'))
    c = (indexlist[i], history[i])
    historywithindex.append(c)













