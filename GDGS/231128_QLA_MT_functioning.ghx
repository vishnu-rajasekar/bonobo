import rhinoscriptsyntax as rs
import ghpythonlib.components as gh
import Rhino.Geometry as rg
import System.Drawing as sd
import math
import random
import copy

################################################################################
#  IMPORT JUNEY FILES
################################################################################
import Assembly as assembly
import Grammar as gr
import Rhino as rc
import Rules as rules
import GraphicStatics as gs

import RandomUtility as ru

import QLA_231125 as qa

reload (assembly)
reload (gs)
reload (rules)
reload (gr)


reload (qa)

################################################################################
#  IMPORT RHINOREMOTE
################################################################################

import scriptcontext
import ghpythonremote
np = scriptcontext.sticky['numpy']
rpy = scriptcontext.sticky['rpy']
pd = scriptcontext.sticky['pandas']

import ghpythonlib.treehelpers as th

################################################################################
#  Code for ML 
################################################################################

scriptcontext.sticky['assembly_list'] = []
episodes = 100

for episode in range(episodes):
    if 'assembly_list' not in scriptcontext.sticky:
        scriptcontext.sticky['assembly_list'] = []
    env.reset()
    env.start()
    i = 0
    while not env.is_done():
        break_while = False
        state = env.get_state() # returns possible node rules
        lists = []
        for s in state:
            lists.append("{x}{y}".format(x=state[0], y=state[2]))
        stup = (tuple(lists))
        
        action = agent.select_action(state)
        lista = []
        lista.append("{l}{m}".format(l=action[0], m=action[2]))
        actup = (tuple(lista))
        
        
        step = env.step(action) # returns and assembly
        if stup not in agent.q_table:
            agent.q_table[stup] = {}

        if actup not in agent.q_table[stup]:
            agent.q_table[stup][actup] = i  # or any default value

        
        state = env.get_state()
        
        
        for node in agent.environment.assembly.Nodes:
            if gh.PointInCurve(node.Coordinate, agent.environment.boundary)[0] == 0: #if node is outside the boundary ideally give a neg reward 
                break_while = True
                break
                
        if break_while:
            break
        if env.is_done() or i&gt;40:
            env.done()
            scriptcontext.sticky['assembly_list'].append(env.assembly)
            state = env.get_state()
            i=0
            
            break
        i+=1  
    print designs


'''state = env.get_state()
action = agent.select_action(state)
step = env.step(action)
state = env.get_state()'''


################################################################################
#  Output
################################################################################
